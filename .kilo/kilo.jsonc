{
  "$schema": "https://app.kilo.ai/config.json",
  "provider": {
    "ollama": {
      "options": {
        "baseURL": "http://localhost:11434/v1",
        "timeout": 300000
      },
      "models": {
        "glm-5.3-flash:cloud": {
          "name": "GLM 5.3 Flash (Ollama Cloud)",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 1000000,
            "output": 32768
          }
        },
        "deepseek-v4.1-flash:cloud": {
          "name": "DeepSeek V4.1 Flash (Ollama Cloud)",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 1000000,
            "output": 32768
          }
        },
        "minimax-m3:cloud": {
          "name": "MiniMax M3 (Ollama Cloud)",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 512000,
            "output": 32768
          }
        },
        "qwen3.5:cloud": {
          "name": "Qwen 3.5 (Ollama Cloud)",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 256000,
            "output": 32768
          }
        }
      }
    }
  }
}
